    <string name="opt_mobilegl_disable_timerquery_desc">游戏可用它测每帧 GPU 耗时（如优化 mod、HUD 显示帧耗时）。部分驱动实现有 bug 会卡顿，关掉即不再提供</string>
    <string name="opt_mobilegl_disable_timerquery_default">关</string>
    <string name="opt_mobilegl_subgroup_emulation_label">子组指令模拟</string>
    <string name="opt_mobilegl_subgroup_emulation_desc">Vulkan 子组指令（一组线程协同操作）驱动不支持时以软件模拟。开＝总是模拟；关＝用驱动原生的，最快</string>
    <string name="opt_mobilegl_subgroup_emulation_default">自动</string>
    <string name="opt_mobilegl_clip_distance_emulation_label">模拟裁剪平面</string>
    <string name="opt_mobilegl_clip_distance_emulation_desc">驱动不支持 gl_ClipDistance 时用「丢弃片元」模拟。开＝总是模拟；关＝用驱动原生的</string>
    <string name="opt_mobilegl_clip_distance_emulation_default">自动</string>
    <string name="opt_mobilegl_coherent_as_flush_label">持久映射当已刷新</string>
    <string name="opt_mobilegl_coherent_as_flush_desc">GPU 缓冲的「持续映射内存」默认要游戏手动刷新才可见。老引擎（如 Flywheel）不刷新就读，导致画面不动；打开后视为自动可见</string>
    <string name="opt_mobilegl_coherent_as_flush_default">关</string>
    <string name="opt_mobilegl_relaxed_semantics_label">放宽 GL 规则</string>
    <string name="opt_mobilegl_relaxed_semantics_desc">允许现代游戏继续使用旧版 OpenGL 中已弃用的用法：绘制时未绑定自定义 VAO、删除纹理后立即重用其名称。仅少数旧模组需要</string>
    <string name="opt_mobilegl_relaxed_semantics_default">关</string>
    <string name="opt_mobilegl_disable_large_buffer_adoption_label">大缓冲不直通 GPU</string>
    <string name="opt_mobilegl_disable_large_buffer_adoption_desc">超过 16MiB 的缓冲不再直接映射给后端，改经 CPU 拷贝。可降低显存占用，并避免 Mali 驱动在处理忙碌缓冲时停顿，代价是写入多一次拷贝</string>
    <string name="opt_mobilegl_disable_large_buffer_adoption_default">关</string>
    <string name="opt_mobilegl_async_shader_compile_label">着色器后台编译</string>
    <string name="opt_mobilegl_async_shader_compile_desc">着色器编译放后台线程，游戏不卡在编译上。自动＝通常等于开</string>
    <string name="opt_mobilegl_async_shader_compile_default">自动</string>
    <string name="opt_mobilegl_async_shader_compile_threads_label">后台编译线程数</string>
    <string name="opt_mobilegl_async_shader_compile_threads_desc">0＝自动（取 min(4, 大核数)）</string>
    <string name="opt_mobilegl_async_shader_compile_threads_default">0（自动）</string>
    <string name="opt_mobilegl_frames_in_flight_label">帧在途数</string>
    <string name="opt_mobilegl_frames_in_flight_desc">CPU 最多提前准备几帧。大＝流畅但吃内存；1＝完全同步，最稳最慢</string>
    <string name="opt_mobilegl_frames_in_flight_default">3</string>
    <string name="opt_mobilegl_shader_cache_label">着色器翻译缓存</string>
    <string name="opt_mobilegl_shader_cache_desc">GLSL 翻译成 GPU 代码的结果存内存里，重进同一画面不用重译。出渲染 bug 时可关掉排查</string>
    <string name="opt_mobilegl_shader_cache_default">自动（通常等于开）</string>
    <string name="opt_mobilegl_enable_spirv_validation_label">SPIR-V 校验</string>
    <string name="opt_mobilegl_enable_spirv_validation_desc">对翻译生成的 GPU 中间码逐条检查合法性。仅用于排查着色器问题；日常开启会持续产生额外开销</string>
    <string name="opt_mobilegl_enable_spirv_validation_default">关</string>
    <string name="opt_mobilegl_pipe_stats_label">管线统计</string>
    <string name="opt_mobilegl_pipe_stats_desc">输出前后端之间每次调用的字节数、次数等计数，用来分析性能瓶颈在哪</string>
    <string name="opt_mobilegl_pipe_stats_default">关</string>
    <string name="opt_mobilegl_fps_log_label">帧率日志</string>
    <string name="opt_mobilegl_fps_log_desc">每两秒输出一行帧率和帧时间</string>
    <string name="opt_mobilegl_fps_log_default">关</string>
    <string name="opt_mobilegl_pipe_stats_period_label">统计输出周期</string>
    <string name="opt_mobilegl_pipe_stats_period_desc">每隔多少帧输出一行统计摘要</string>
    <string name="opt_mobilegl_pipe_stats_period_default">120 帧</string>
    <string name="opt_mobilegl_advertise_fp64_label">假装支持双精度</string>
    <string name="opt_mobilegl_advertise_fp64_desc">部分光影包在检测到不支持双精度时会拒绝加载。开启后向游戏声明支持双精度（GL_ARB_gpu_shader_fp64），实际运算仍为 32 位精度，可通过检查但精度受限</string>
    <string name="opt_mobilegl_advertise_fp64_default">关</string>
    <string name="opt_mobilegl_disable_shader_prewarm_label">跳过着色器预热</string>
    <string name="opt_mobilegl_disable_shader_prewarm_desc">启动时预先初始化编译器内建表，可缩短 20-100 毫秒启动时间；代价是首次编译着色器稍慢</string>
    <string name="opt_mobilegl_disable_shader_prewarm_default">关</string>
    <string name="opt_mobilegl_async_optimistic_shader_status_label">编译中先报成功</string>
    <string name="opt_mobilegl_async_optimistic_shader_status_desc">着色器尚在后台编译时即向游戏返回完成状态，无需同步等待。实际编译失败仍会报错，但游戏可能先获得未完成的着色器</string>
    <string name="opt_mobilegl_async_optimistic_shader_status_default">自动（通常等于关）</string>
    <string name="opt_mobilegl_point_size_demotion_label">点大小前移</string>
    <string name="opt_mobilegl_point_size_demotion_desc">把 gl_PointSize 的计算从几何着色器挪到顶点着色器。某些驱动几何阶段改不了点大小，需要这个</string>
    <string name="opt_mobilegl_point_size_demotion_default">自动</string>
    <string name="opt_mobilegl_itrp_fix_label">iterationRP 修复</string>
    <string name="opt_mobilegl_itrp_fix_desc">修 iterationRP 光影包自带的两个计算着色器 bug。自动＝装了这个光影包才修</string>
    <string name="opt_mobilegl_itrp_fix_default">自动</string>
    <string name="opt_mobilegl_pipe_framebuffer_state_memo_label">帧缓冲状态记忆</string>
    <string name="opt_mobilegl_pipe_framebuffer_state_memo_desc">记住帧缓冲当前绑定，游戏重复设置同样的状态时直接跳过，省调用</string>
    <string name="opt_mobilegl_pipe_framebuffer_state_memo_default">自动</string>
    <string name="opt_mobilegl_pipe_persistent_mprotect_label">按页同步映射改动</string>
    <string name="opt_mobilegl_pipe_persistent_mprotect_desc">持久映射的缓冲只把改过的内存页同步给后端，没改的页用内存保护挡住，减少无效拷贝</string>
    <string name="opt_mobilegl_pipe_persistent_mprotect_default">开</string>
    <string name="opt_mobilegl_pipe_push_label">命令推送掩码</string>
    <string name="opt_mobilegl_pipe_push_desc">哪些子系统走新的前后端直推路径（位掩码，十进制或 0x 十六进制）。官方默认 0x3fff＝全部已迁移；填 0＝全部退回旧路径</string>
    <string name="opt_mobilegl_pipe_push_default">0x3fff（bit0-13 全部已迁移）</string>
    <string name="opt_mobilegl_pipe_verify_label">管线校验</string>
    <string name="opt_mobilegl_pipe_verify_desc">每次绘制逐字段比对新旧两条路径的状态，用于排查。慢 5-10 倍</string>
    <string name="opt_mobilegl_pipe_verify_default">关</string>
    <string name="opt_mobilegl_pipe_verify_fatal_label">校验失败即中止</string>
    <string name="opt_mobilegl_pipe_verify_fatal_desc">发现第一处不一致就崩掉，方便抓现场；关＝只记日志继续跑</string>
    <string name="opt_mobilegl_pipe_verify_fatal_default">自动（校验开启时等于中止）</string>
    <string name="opt_mobilegl_pipe_vertex_elements_dedup_label">顶点属性去重</string>
    <string name="opt_mobilegl_pipe_vertex_elements_dedup_desc">顶点格式没变时不重复下发，减少前后端通信</string>
    <string name="opt_mobilegl_pipe_vertex_elements_dedup_default">自动</string>
    <string name="opt_mobilegl_magma_r11g11b10f_fallback_label">HDR 格式回退</string>
    <string name="opt_mobilegl_magma_r11g11b10f_fallback_desc">驱动不支持 R11G11B10F（一种省显存的高动态范围格式）时换用兼容格式</string>
    <string name="opt_mobilegl_magma_r11g11b10f_fallback_default">关</string>
    <string name="opt_mobilegl_magma_extra_swapchain_images_label">额外画面缓冲</string>
    <string name="opt_mobilegl_magma_extra_swapchain_images_desc">交换链多备几张图，游戏提交画面不用等上一张显示完。每张多占一份全屏显存</string>
    <string name="opt_mobilegl_magma_extra_swapchain_images_default">0</string>
    <string name="opt_mobilegl_magma_split_slice_copies_label">分层纹理拷贝</string>
    <string name="opt_mobilegl_magma_split_slice_copies_desc">跨格式拷贝大纹理时一层一层提交。部分 Adreno 只拷第一层，拆开能修好</string>
    <string name="opt_mobilegl_magma_split_slice_copies_default">自动（探测到才启用）</string>
    <string name="opt_mobilegl_magma_pass_cache_label">渲染通道复用</string>
    <string name="opt_mobilegl_magma_pass_cache_desc">Vulkan 的渲染通道对象很贵，内容没变的帧直接复用上一帧的</string>
    <string name="opt_mobilegl_magma_pass_cache_default">自动（通常等于开）</string>
    <string name="opt_mobilegl_magma_reemit_state_after_discard_label">丢弃后补状态</string>
    <string name="opt_mobilegl_magma_reemit_state_after_discard_desc">画面内容被丢弃后重新下发绘制状态，避免那一帧空白</string>
    <string name="opt_mobilegl_magma_reemit_state_after_discard_default">自动（探测到设备需要才启用）</string>
    <string name="opt_mobilegl_magma_disable_blended_depth_write_label">高通混合写深度</string>
    <string name="opt_mobilegl_magma_disable_blended_depth_write_desc">高通驱动在启用透明混合时会抑制深度写入，部分游戏依赖此行为。自动＝仅在高通设备上模拟该行为</string>
    <string name="opt_mobilegl_magma_disable_blended_depth_write_default">自动（只在高通设备上套用）</string>
    <string name="opt_mobilegl_magma_framesinflight_label">帧在途数（旧名）</string>
    <string name="opt_mobilegl_magma_framesinflight_desc">MOBILEGL_FRAMES_IN_FLIGHT 的旧拼法，已被取代</string>
    <string name="opt_mobilegl_magma_framesinflight_default">3（同帧在途数）</string>
    <string name="opt_mobilegl_magma_e5_raw_reads_label">E5B9G9R9 直读</string>
    <string name="opt_mobilegl_magma_e5_raw_reads_desc">这种共享指数的纹理格式直接按原始位读取，绕过驱动错误的自动转换</string>
    <string name="opt_mobilegl_magma_e5_raw_reads_default">自动（探测到才启用）</string>
    <string name="opt_mobilegl_magma_allow_invalid_spirv_label">容忍无效 SPIR-V</string>
    <string name="opt_mobilegl_magma_allow_invalid_spirv_desc">没过校验的着色器代码也交给驱动试试，排查用</string>
    <string name="opt_mobilegl_magma_allow_invalid_spirv_default">关</string>
    <string name="opt_mobilegl_magma_disable_robust_buffer_access_label">关越界保护</string>
    <string name="opt_mobilegl_magma_disable_robust_buffer_access_desc">Vulkan 默认保证越界读取不崩溃。关掉省一点性能，但越界就是未定义行为，可能花屏</string>
    <string name="opt_mobilegl_magma_disable_robust_buffer_access_default">关</string>
    <string name="opt_mobilegl_magma_primgen_query_reroute_label">图元数查询改道</string>
    <string name="opt_mobilegl_magma_primgen_query_reroute_desc">统计画了多少个三角形的查询，部分驱动返回错值，改走另一条路径</string>
    <string name="opt_mobilegl_magma_primgen_query_reroute_default">自动（探测到问题才启用）</string>
    <string name="opt_mobilegl_magma_vertex_conversion_cache_label">顶点格式转换缓存</string>
    <string name="opt_mobilegl_magma_vertex_conversion_cache_desc">需要 CPU 转格式的顶点数据每帧只转一次，多次绘制共用</string>
    <string name="opt_mobilegl_magma_vertex_conversion_cache_default">自动（通常等于开）</string>
    <string name="opt_mobilegl_magma_write_rename_label">写入换块</string>
    <string name="opt_mobilegl_magma_write_rename_desc">GPU 还在读的缓冲要写入时换一块新内存写，不用等它读完（类似副本-on-write）</string>
    <string name="opt_mobilegl_magma_write_rename_default">自动</string>
    <string name="opt_mobilegl_magma_multidraw_mode_label">多次绘制实现</string>
    <string name="opt_mobilegl_magma_multidraw_mode_desc">Magma 一次提交多个 draw 的方式：ext／indirect／unroll。auto＝选设备支持里最好的</string>
    <string name="opt_mobilegl_magma_multidraw_mode_default">自动</string>
    <string name="opt_mobilegl_magma_descriptor_trim_frames_label">描述符池回收</string>
    <string name="opt_mobilegl_magma_descriptor_trim_frames_desc">连续这么多帧没有增长需求就回收描述符池。0＝从不回收</string>
    <string name="opt_mobilegl_magma_descriptor_trim_frames_default">120 帧</string>
    <string name="opt_mobilegl_magma_max_draws_per_command_buffer_label">单缓冲绘制上限</string>
    <string name="opt_mobilegl_magma_max_draws_per_command_buffer_desc">一帧内累计这么多 draw 就先提交一次。0＝从不主动提交。限制大加载帧占用的显存</string>
    <string name="opt_mobilegl_magma_max_draws_per_command_buffer_default">16384</string>
    <string name="opt_mobilegl_magma_inpass_clear_label">渲染中清屏合并</string>
    <string name="opt_mobilegl_magma_inpass_clear_desc">清屏操作直接并进渲染通道开头，少一次全屏写入</string>
    <string name="opt_mobilegl_magma_inpass_clear_default">自动（只在能证明等价时启用）</string>
    <string name="opt_mobilegl_magma_inpass_clear_default_label">渲染中清屏（默认帧缓冲）</string>
    <string name="opt_mobilegl_magma_inpass_clear_default_desc">同上，但作用于屏幕本身那个帧缓冲。自动＝关（Adreno 750 有回归）</string>
    <string name="opt_mobilegl_magma_inpass_clear_default_default">自动（等于关闭）</string>
    <string name="opt_mobilegl_espryt_enable_texture_view_label">纹理视图扩展</string>
    <string name="opt_mobilegl_espryt_enable_texture_view_desc">对外声明支持 GL_ARB_texture_view（同一张纹理的不同解读方式）</string>
    <string name="opt_mobilegl_espryt_enable_texture_view_default">关</string>
    <string name="opt_mobilegl_espryt_use_angle_label">经由 ANGLE 渲染</string>
    <string name="opt_mobilegl_espryt_use_angle_desc">改用 ANGLE（Google 的 GLES-on-Vulkan 实现）替代系统 GLES 驱动。作为兼容性备选方案</string>
    <string name="opt_mobilegl_espryt_use_angle_default">关</string>
    <string name="opt_mobilegl_espryt_disable_upload_ring_label">禁用上传环</string>
    <string name="opt_mobilegl_espryt_disable_upload_ring_desc">缓冲数据不走环形上传队列，改回老的逐次拷贝，兼容个别驱动</string>
    <string name="opt_mobilegl_espryt_disable_upload_ring_default">关</string>
    <string name="opt_mobilegl_espryt_avoid_sampler_mipmap_min_filter_label">禁用 mipmap 缩小采样</string>
    <string name="opt_mobilegl_espryt_avoid_sampler_mipmap_min_filter_desc">缩小采样不用 mipmap，规避部分驱动贴图发黑的 bug，画质略降</string>
    <string name="opt_mobilegl_espryt_avoid_sampler_mipmap_min_filter_default">关</string>
    <string name="opt_mobilegl_espryt_vao_shadow_label">顶点状态去重</string>
    <string name="opt_mobilegl_espryt_vao_shadow_desc">只在顶点属性真正变化时才通知驱动，避免重复设置</string>
    <string name="opt_mobilegl_espryt_vao_shadow_default">自动</string>
    <string name="opt_mobilegl_espryt_defer_geometry_emits_label">几何输出延迟</string>
    <string name="opt_mobilegl_espryt_defer_geometry_emits_desc">几何着色器先写完内存再产出顶点。Adreno 会在 emit 后丢写入，需要这个</string>
    <string name="opt_mobilegl_espryt_defer_geometry_emits_default">自动（探测到才启用）</string>
    <string name="opt_mobilegl_pipe_index_mirror_mb_label">索引缓冲镜像上限</string>
    <string name="opt_mobilegl_pipe_index_mirror_mb_desc">后端留一块内存镜像索引数据（MiB），装得下才能做图元重启改写和多次绘制合并</string>
    <string name="opt_mobilegl_pipe_index_mirror_mb_default">64</string>
    <string name="opt_mobilegl_espryt_avoid_explicit_lod_bias_label">忽略 LOD 偏移</string>
    <string name="opt_mobilegl_espryt_avoid_explicit_lod_bias_desc">不叠加游戏写的细节层级偏移。规避 ANGLE + llvmpipe 的崩溃</string>
    <string name="opt_mobilegl_espryt_avoid_explicit_lod_bias_default">关</string>
    <string name="opt_mobilegl_espryt_disable_invalidate_flush_label">禁用失效刷新</string>
    <string name="opt_mobilegl_espryt_disable_invalidate_flush_desc">映射内存的「先失效再读」路径跳过，直接走拷贝，个别驱动在该路径上会停止响应</string>
    <string name="opt_mobilegl_espryt_disable_invalidate_flush_default">关</string>
    <string name="opt_mobilegl_espryt_disable_ubo_ring_label">禁用 UBO 环</string>
    <string name="opt_mobilegl_espryt_disable_ubo_ring_desc">全局常量缓冲不走环形队列，回老式直接写入</string>
    <string name="opt_mobilegl_espryt_disable_ubo_ring_default">关</string>
    <string name="opt_mobilegl_espryt_disable_unpack_ring_label">禁用纹理上传环</string>
    <string name="opt_mobilegl_espryt_disable_unpack_ring_desc">纹理上传不走环形队列，回老式逐次拷贝</string>
    <string name="opt_mobilegl_espryt_disable_unpack_ring_default">关</string>
    <string name="opt_mobilegl_espryt_force_ds_readback_emulation_label">深度模板模拟回读</string>
    <string name="opt_mobilegl_espryt_force_ds_readback_emulation_desc">读回深度/模板改走 CPU 模拟路径，不用原生 GLES 读回</string>
    <string name="opt_mobilegl_espryt_force_ds_readback_emulation_default">关</string>
    <string name="opt_mobilegl_espryt_force_viewport_array_emulation_label">多视口模拟</string>
    <string name="opt_mobilegl_espryt_force_viewport_array_emulation_desc">多视口扩展用软件模拟，不用驱动原生实现</string>
    <string name="opt_mobilegl_espryt_force_viewport_array_emulation_default">自动</string>
    <string name="opt_mobilegl_espryt_invalid_image_placeholder_label">非法图像占位</string>
    <string name="opt_mobilegl_espryt_invalid_image_placeholder_desc">游戏绑定无效图像时改绑一张空白图像，而不是按规范报错。部分游戏依赖报错后的既定行为，此选项会改变该行为</string>
    <string name="opt_mobilegl_espryt_invalid_image_placeholder_default">自动</string>
    <string name="opt_mobilegl_espryt_unlocated_io_blocks_label">自动分配着色器接口位置</string>
    <string name="opt_mobilegl_espryt_unlocated_io_blocks_desc">着色器输入输出块没写位置编号时按声明顺序补上</string>
    <string name="opt_mobilegl_espryt_unlocated_io_blocks_default">自动</string>
    <string name="opt_mobilegl_espryt_widen_packed16_storage_label">加宽 16 位格式存储</string>
    <string name="opt_mobilegl_espryt_widen_packed16_storage_desc">RGB565 这类 16 位纹理内部用 32 位存，避免精度丢失；显存翻倍</string>
    <string name="opt_mobilegl_espryt_widen_packed16_storage_default">自动（探测到驱动出问题才启用）</string>
    <string name="opt_mobilegl_espryt_multidraw_mode_label">多次绘制模拟</string>
