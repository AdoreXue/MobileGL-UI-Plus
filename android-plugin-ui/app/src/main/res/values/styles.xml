<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MobileGLPlugin" parent="@android:style/Theme.Material.NoActionBar">
        <!-- Cold start window: plain color only, no icon. Android 12+ still requires a
             splash screen, so the icon layer is an empty drawable. -->
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
    </style>
    <style name="Theme.MobileGLPlugin.NoDisplay" parent="@android:style/Theme.NoDisplay" />
</resources>
